  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/preferences": "8.0.1",
    "html2canvas": "1.4.1",
    "qrcodejs": "1.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.10",
    "@tailwindcss/cli": "4.1.10"
  }
}
