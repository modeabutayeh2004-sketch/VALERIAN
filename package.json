{
  "name": "valerian-android",
  "version": "20.7.0",
  "private": true,
  "description": "VALERIAN V20 Android wrapper",
  "scripts": {
    "build:web": "node scripts/prepare-web.mjs",
    "build:android": "npm run build:web && cap sync android",
